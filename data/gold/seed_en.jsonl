{"id": "en-001", "language": "english", "split": "dev", "text": "Women should stay at home and leave research to men.", "label": 1, "category": "explicit_discrimination", "hard_negative": false, "source": "seed-claude"}
{"id": "en-002", "language": "english", "split": "dev", "text": "We are looking for a male engineer to lead the lab.", "label": 1, "category": "explicit_discrimination", "hard_negative": false, "source": "seed-claude"}
{"id": "en-003", "language": "english", "split": "dev", "text": "Female scientists are too emotional to manage large teams.", "label": 1, "category": "gender_stereotype", "hard_negative": false, "source": "seed-claude"}
{"id": "en-004", "language": "english", "split": "dev", "text": "Each researcher must submit his report by Friday.", "label": 1, "category": "generic_masculine", "hard_negative": false, "source": "seed-claude"}
{"id": "en-005", "language": "english", "split": "dev", "text": "The chairman will open the conference.", "label": 1, "category": "gendered_term", "hard_negative": false, "source": "seed-claude"}
{"id": "en-006", "language": "english", "split": "dev", "text": "Mankind has always sought to understand the stars.", "label": 1, "category": "androcentric", "hard_negative": false, "source": "seed-claude"}
{"id": "en-007", "language": "english", "split": "dev", "text": "We need more manpower to complete the data collection.", "label": 1, "category": "gendered_term", "hard_negative": false, "source": "seed-claude"}
{"id": "en-008", "language": "english", "split": "dev", "text": "Candidates must be under 35 and of good appearance.", "label": 1, "category": "explicit_discrimination", "hard_negative": false, "source": "seed-claude"}
{"id": "en-009", "language": "english", "split": "dev", "text": "The nurses, who are naturally caring women, will collect the samples.", "label": 1, "category": "gender_stereotype", "hard_negative": false, "source": "seed-claude"}
{"id": "en-010", "language": "english", "split": "dev", "text": "Immigrants are a burden on the healthcare system.", "label": 1, "category": "other_discrimination", "hard_negative": false, "source": "seed-claude"}
{"id": "en-011", "language": "english", "split": "dev", "text": "Handicapped participants will use the rear entrance.", "label": 1, "category": "other_discrimination", "hard_negative": false, "source": "seed-claude"}
{"id": "en-012", "language": "english", "split": "dev", "text": "The elderly are incapable of learning new technologies.", "label": 1, "category": "other_discrimination", "hard_negative": false, "source": "seed-claude"}
{"id": "en-013", "language": "english", "split": "dev", "text": "Girls are naturally worse at mathematics than boys.", "label": 1, "category": "gender_stereotype", "hard_negative": false, "source": "seed-claude"}
{"id": "en-014", "language": "english", "split": "dev", "text": "Only men may apply for the field engineering position.", "label": 1, "category": "explicit_discrimination", "hard_negative": false, "source": "seed-claude"}
{"id": "en-015", "language": "english", "split": "dev", "text": "We prefer male candidates for the leadership role.", "label": 1, "category": "explicit_discrimination", "hard_negative": false, "source": "seed-claude"}
{"id": "en-016", "language": "english", "split": "dev", "text": "The secretary, a beautiful young woman, will handle the paperwork.", "label": 1, "category": "gender_stereotype", "hard_negative": false, "source": "seed-claude"}
{"id": "en-017", "language": "english", "split": "dev", "text": "Working mothers are less committed to their research careers.", "label": 1, "category": "gender_stereotype", "hard_negative": false, "source": "seed-claude"}
{"id": "en-018", "language": "english", "split": "dev", "text": "Illegal aliens were excluded from the survey.", "label": 1, "category": "other_discrimination", "hard_negative": false, "source": "seed-claude"}
{"id": "en-019", "language": "english", "split": "dev", "text": "The patient is confined to a wheelchair and suffers from autism.", "label": 1, "category": "other_discrimination", "hard_negative": false, "source": "seed-claude"}
{"id": "en-020", "language": "english", "split": "dev", "text": "A good scientist knows his limitations.", "label": 1, "category": "generic_masculine", "hard_negative": false, "source": "seed-claude"}
{"id": "en-021", "language": "english", "split": "dev", "text": "Policemen and firemen were interviewed for the study.", "label": 1, "category": "gendered_term", "hard_negative": false, "source": "seed-claude"}
{"id": "en-022", "language": "english", "split": "dev", "text": "Men are natural leaders while women are better at supporting roles.", "label": 1, "category": "gender_stereotype", "hard_negative": false, "source": "seed-claude"}
{"id": "en-023", "language": "english", "split": "dev", "text": "The study analyses the labour integration of immigrant populations in the Canary Islands.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "en-024", "language": "english", "split": "dev", "text": "Participants must be over 18 years old to give informed consent.", "label": 0, "category": "none", "hard_negative": false, "source": "seed-claude"}
{"id": "en-025", "language": "english", "split": "dev", "text": "This project promotes gender equality and inclusion in STEM.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "en-026", "language": "english", "split": "dev", "text": "We analyse the gender pay gap between women and men in the technology sector.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "en-027", "language": "english", "split": "dev", "text": "The research team includes six women and four men.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "en-028", "language": "english", "split": "dev", "text": "Each researcher must submit their report by Friday.", "label": 0, "category": "none", "hard_negative": false, "source": "seed-claude"}
{"id": "en-029", "language": "english", "split": "dev", "text": "The chair will open the conference.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "en-030", "language": "english", "split": "dev", "text": "Humankind has always sought to understand the stars.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "en-031", "language": "english", "split": "dev", "text": "We recruited 20 participants with a disability.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "en-032", "language": "english", "split": "dev", "text": "The study examines stereotypes that associate women with caregiving.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "en-033", "language": "english", "split": "dev", "text": "Gender-based violence affects women of all ages.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "en-034", "language": "english", "split": "dev", "text": "Older adults aged 65 and over made up 20% of the sample.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "en-035", "language": "english", "split": "dev", "text": "The nurse in charge of the trial is Dr. Smith; she has ten years of experience.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "en-036", "language": "english", "split": "dev", "text": "Women remain underrepresented in senior academic positions.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "en-037", "language": "english", "split": "dev", "text": "Data will be stored on a secure university server.", "label": 0, "category": "none", "hard_negative": false, "source": "seed-claude"}
{"id": "en-038", "language": "english", "split": "dev", "text": "The sample includes patients between 30 and 50 years of age.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "en-039", "language": "english", "split": "dev", "text": "We welcome applications from all qualified candidates regardless of gender.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "en-040", "language": "english", "split": "dev", "text": "The workforce will be expanded to complete the data collection.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "en-041", "language": "english", "split": "dev", "text": "Wheelchair users will have step-free access to the building.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "en-042", "language": "english", "split": "dev", "text": "Ethnic minority students reported higher rates of discrimination.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "en-043", "language": "english", "split": "dev", "text": "A logistic regression model was fitted to the survey data.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "en-044", "language": "english", "split": "dev", "text": "Our engineers and nurses will co-design the device with patients.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "en-045", "language": "english", "split": "dev", "text": "He presented the results at the 2024 annual meeting.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
