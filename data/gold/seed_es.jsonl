{"id": "es-001", "language": "spanish", "split": "dev", "text": "Las enfermeras son cariñosas y las ingenieras agresivas.", "label": 1, "category": "gender_stereotype", "hard_negative": false, "source": "seed-claude"}
{"id": "es-002", "language": "spanish", "split": "dev", "text": "Se busca hombre para el puesto de jefe de laboratorio.", "label": 1, "category": "explicit_discrimination", "hard_negative": false, "source": "seed-claude"}
{"id": "es-003", "language": "spanish", "split": "dev", "text": "Las mujeres no tienen la capacidad lógica necesaria para liderar el proyecto.", "label": 1, "category": "gender_stereotype", "hard_negative": false, "source": "seed-claude"}
{"id": "es-004", "language": "spanish", "split": "dev", "text": "Preferiblemente hombre, menor de 35 años, con buena presencia.", "label": 1, "category": "explicit_discrimination", "hard_negative": false, "source": "seed-claude"}
{"id": "es-005", "language": "spanish", "split": "dev", "text": "Los investigadores deberán presentar su currículum antes del 30 de junio.", "label": 1, "category": "generic_masculine", "hard_negative": false, "source": "seed-claude"}
{"id": "es-006", "language": "spanish", "split": "dev", "text": "Todos los alumnos participantes firmarán el consentimiento.", "label": 1, "category": "generic_masculine", "hard_negative": false, "source": "seed-claude"}
{"id": "es-007", "language": "spanish", "split": "dev", "text": "El hombre ha transformado su entorno desde la prehistoria.", "label": 1, "category": "androcentric", "hard_negative": false, "source": "seed-claude"}
{"id": "es-008", "language": "spanish", "split": "dev", "text": "Los directores de los grupos de investigación coordinarán a los becarios.", "label": 1, "category": "generic_masculine", "hard_negative": false, "source": "seed-claude"}
{"id": "es-009", "language": "spanish", "split": "dev", "text": "La secretaria del proyecto, una chica muy guapa, gestionará la documentación.", "label": 1, "category": "gender_stereotype", "hard_negative": false, "source": "seed-claude"}
{"id": "es-010", "language": "spanish", "split": "dev", "text": "Las mujeres son más emocionales y por eso se dedican a los cuidados.", "label": 1, "category": "gender_stereotype", "hard_negative": false, "source": "seed-claude"}
{"id": "es-011", "language": "spanish", "split": "dev", "text": "Los inmigrantes son una carga para el sistema sanitario.", "label": 1, "category": "other_discrimination", "hard_negative": false, "source": "seed-claude"}
{"id": "es-012", "language": "spanish", "split": "dev", "text": "Los minusválidos tendrán acceso al edificio por la puerta trasera.", "label": 1, "category": "other_discrimination", "hard_negative": false, "source": "seed-claude"}
{"id": "es-013", "language": "spanish", "split": "dev", "text": "Los ancianos no son capaces de usar herramientas digitales.", "label": 1, "category": "other_discrimination", "hard_negative": false, "source": "seed-claude"}
{"id": "es-014", "language": "spanish", "split": "dev", "text": "El equipo necesita un líder fuerte y agresivo, un hombre de carácter.", "label": 1, "category": "gender_stereotype", "hard_negative": false, "source": "seed-claude"}
{"id": "es-015", "language": "spanish", "split": "dev", "text": "Solo mujeres para el puesto de recepcionista.", "label": 1, "category": "explicit_discrimination", "hard_negative": false, "source": "seed-claude"}
{"id": "es-016", "language": "spanish", "split": "dev", "text": "La señorita García y el doctor Pérez presentarán los resultados.", "label": 1, "category": "gender_stereotype", "hard_negative": false, "source": "seed-claude"}
{"id": "es-017", "language": "spanish", "split": "dev", "text": "Los gitanos suelen ser conflictivos en las aulas.", "label": 1, "category": "other_discrimination", "hard_negative": false, "source": "seed-claude"}
{"id": "es-018", "language": "spanish", "split": "dev", "text": "Las madres trabajadoras son menos productivas en la investigación.", "label": 1, "category": "gender_stereotype", "hard_negative": false, "source": "seed-claude"}
{"id": "es-019", "language": "spanish", "split": "dev", "text": "El coordinador y sus colaboradores serán evaluados anualmente.", "label": 1, "category": "generic_masculine", "hard_negative": false, "source": "seed-claude"}
{"id": "es-020", "language": "spanish", "split": "dev", "text": "Las maestras de primaria enseñan con dulzura porque son más pacientes por naturaleza.", "label": 1, "category": "gender_stereotype", "hard_negative": false, "source": "seed-claude"}
{"id": "es-021", "language": "spanish", "split": "dev", "text": "Buscamos científicos jóvenes, preferiblemente varones.", "label": 1, "category": "explicit_discrimination", "hard_negative": false, "source": "seed-claude"}
{"id": "es-022", "language": "spanish", "split": "dev", "text": "Exclusivamente hombres podrán acceder a la beca de ingeniería.", "label": 1, "category": "explicit_discrimination", "hard_negative": false, "source": "seed-claude"}
{"id": "es-023", "language": "spanish", "split": "dev", "text": "Los trabajadores inmigrantes ilegales serán excluidos del estudio.", "label": 1, "category": "other_discrimination", "hard_negative": false, "source": "seed-claude"}
{"id": "es-024", "language": "spanish", "split": "dev", "text": "Las niñas son más tranquilas y los niños más inquietos por naturaleza.", "label": 1, "category": "gender_stereotype", "hard_negative": false, "source": "seed-claude"}
{"id": "es-025", "language": "spanish", "split": "dev", "text": "Los usuarios del servicio responderán a la encuesta.", "label": 1, "category": "generic_masculine", "hard_negative": false, "source": "seed-claude"}
{"id": "es-026", "language": "spanish", "split": "dev", "text": "Las mujeres deben quedarse en casa. Este proyecto promueve la igualdad de género.", "label": 1, "category": "explicit_discrimination", "hard_negative": false, "source": "seed-claude"}
{"id": "es-027", "language": "spanish", "split": "dev", "text": "El estudio analiza la integración laboral de la población inmigrante en Canarias.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "es-028", "language": "spanish", "split": "dev", "text": "Las personas participantes deberán ser mayores de 18 años.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "es-029", "language": "spanish", "split": "dev", "text": "El proyecto incorpora la perspectiva de género en todas sus fases.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "es-030", "language": "spanish", "split": "dev", "text": "Se analizará la brecha salarial entre mujeres y hombres en el sector tecnológico.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "es-031", "language": "spanish", "split": "dev", "text": "El personal investigador presentará un informe anual.", "label": 0, "category": "none", "hard_negative": false, "source": "seed-claude"}
{"id": "es-032", "language": "spanish", "split": "dev", "text": "El alumnado participante firmará el consentimiento informado.", "label": 0, "category": "none", "hard_negative": false, "source": "seed-claude"}
{"id": "es-033", "language": "spanish", "split": "dev", "text": "Investigadoras e investigadores colaborarán en la recogida de datos.", "label": 0, "category": "none", "hard_negative": false, "source": "seed-claude"}
{"id": "es-034", "language": "spanish", "split": "dev", "text": "La violencia de género afecta a mujeres de todas las edades.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "es-035", "language": "spanish", "split": "dev", "text": "El estudio examina los estereotipos que asocian a las mujeres con los cuidados.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "es-036", "language": "spanish", "split": "dev", "text": "Las personas mayores de 65 años constituyen el 20% de la muestra.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "es-037", "language": "spanish", "split": "dev", "text": "Se garantiza la accesibilidad para las personas con discapacidad.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "es-038", "language": "spanish", "split": "dev", "text": "La enfermera responsable del ensayo clínico es la doctora López.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "es-039", "language": "spanish", "split": "dev", "text": "El equipo de investigación está formado por seis mujeres y cuatro hombres.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "es-040", "language": "spanish", "split": "dev", "text": "La humanidad ha transformado su entorno desde la prehistoria.", "label": 0, "category": "none", "hard_negative": false, "source": "seed-claude"}
{"id": "es-041", "language": "spanish", "split": "dev", "text": "La dirección del proyecto coordinará al equipo becario.", "label": 0, "category": "none", "hard_negative": false, "source": "seed-claude"}
{"id": "es-042", "language": "spanish", "split": "dev", "text": "Los datos se almacenarán en un servidor seguro de la universidad.", "label": 0, "category": "none", "hard_negative": false, "source": "seed-claude"}
{"id": "es-043", "language": "spanish", "split": "dev", "text": "Se aplicará un análisis de regresión logística a las variables.", "label": 0, "category": "none", "hard_negative": false, "source": "seed-claude"}
{"id": "es-044", "language": "spanish", "split": "dev", "text": "La comunidad gitana presenta tasas más altas de abandono escolar según el INE.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "es-045", "language": "spanish", "split": "dev", "text": "Promovemos la igualdad de oportunidades entre mujeres y hombres en la ciencia.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "es-046", "language": "spanish", "split": "dev", "text": "Las mujeres científicas siguen infrarrepresentadas en los puestos de liderazgo.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "es-047", "language": "spanish", "split": "dev", "text": "La muestra incluye pacientes de entre 30 y 50 años.", "label": 0, "category": "none", "hard_negative": false, "source": "seed-claude"}
{"id": "es-048", "language": "spanish", "split": "dev", "text": "El objetivo es reducir la brecha digital de las personas mayores.", "label": 0, "category": "none", "hard_negative": true, "source": "seed-claude"}
{"id": "es-049", "language": "spanish", "split": "dev", "text": "La persona responsable de la coordinación será elegida por el consejo.", "label": 0, "category": "none", "hard_negative": false, "source": "seed-claude"}
{"id": "es-050", "language": "spanish", "split": "dev", "text": "La ciudadanía podrá consultar los resultados en la web del proyecto.", "label": 0, "category": "none", "hard_negative": false, "source": "seed-claude"}
