{"id": "en-h001", "language": "english", "split": "test", "text": "We need a young, energetic girl to staff the conference reception desk.", "label": 1, "category": "explicit_discrimination", "hard_negative": false, "source": "holdout-claude"}
{"id": "en-h002", "language": "english", "split": "test", "text": "Men are better suited to fieldwork because of their physical strength.", "label": 1, "category": "gender_stereotype", "hard_negative": false, "source": "holdout-claude"}
{"id": "en-h003", "language": "english", "split": "test", "text": "Female researchers tend to leave science once they have children because they put family first.", "label": 1, "category": "gender_stereotype", "hard_negative": false, "source": "holdout-claude"}
{"id": "en-h004", "language": "english", "split": "test", "text": "Every applicant should ensure that his budget is realistic.", "label": 1, "category": "generic_masculine", "hard_negative": false, "source": "holdout-claude"}
{"id": "en-h005", "language": "english", "split": "test", "text": "The project relies on the expertise of local fishermen.", "label": 1, "category": "gendered_term", "hard_negative": false, "source": "holdout-claude"}
{"id": "en-h006", "language": "english", "split": "test", "text": "The evolution of man has been shaped by tool use.", "label": 1, "category": "androcentric", "hard_negative": false, "source": "holdout-claude"}
{"id": "en-h007", "language": "english", "split": "test", "text": "Women are worse drivers than men.", "label": 1, "category": "gender_stereotype", "hard_negative": false, "source": "holdout-claude"}
{"id": "en-h008", "language": "english", "split": "test", "text": "Immigrants tend to be criminals, according to the interviewer.", "label": 1, "category": "other_discrimination", "hard_negative": false, "source": "holdout-claude"}
{"id": "en-h009", "language": "english", "split": "test", "text": "The building is not suitable for invalids.", "label": 1, "category": "other_discrimination", "hard_negative": false, "source": "holdout-claude"}
{"id": "en-h010", "language": "english", "split": "test", "text": "An attractive appearance is required for the event hostess role.", "label": 1, "category": "other_discrimination", "hard_negative": false, "source": "holdout-claude"}
{"id": "en-h011", "language": "english", "split": "test", "text": "Girls are not good at programming.", "label": 1, "category": "gender_stereotype", "hard_negative": false, "source": "holdout-claude"}
{"id": "en-h012", "language": "english", "split": "test", "text": "Old people are a burden on the pension system.", "label": 1, "category": "other_discrimination", "hard_negative": false, "source": "holdout-claude"}
{"id": "en-h013", "language": "english", "split": "test", "text": "A woman leading the lab would be too emotional to make hard decisions.", "label": 1, "category": "gender_stereotype", "hard_negative": false, "source": "holdout-claude"}
{"id": "en-h014", "language": "english", "split": "test", "text": "The workshop will be led by our cameraman and two technicians.", "label": 1, "category": "gendered_term", "hard_negative": false, "source": "holdout-claude"}
{"id": "en-h015", "language": "english", "split": "test", "text": "Mental retards were excluded from the trial.", "label": 1, "category": "other_discrimination", "hard_negative": false, "source": "holdout-claude"}
{"id": "en-h016", "language": "english", "split": "test", "text": "Every applicant should ensure that their budget is realistic.", "label": 0, "category": "none", "hard_negative": false, "source": "holdout-claude"}
{"id": "en-h017", "language": "english", "split": "test", "text": "The project relies on the expertise of local fishers.", "label": 0, "category": "none", "hard_negative": false, "source": "holdout-claude"}
{"id": "en-h018", "language": "english", "split": "test", "text": "Human evolution has been shaped by tool use.", "label": 0, "category": "none", "hard_negative": false, "source": "holdout-claude"}
{"id": "en-h019", "language": "english", "split": "test", "text": "The study measures occupational segregation of women in engineering.", "label": 0, "category": "none", "hard_negative": true, "source": "holdout-claude"}
{"id": "en-h020", "language": "english", "split": "test", "text": "Women make up 38% of the university's research staff.", "label": 0, "category": "none", "hard_negative": true, "source": "holdout-claude"}
{"id": "en-h021", "language": "english", "split": "test", "text": "We will analyse the migration paths of the Moroccan population living in Tenerife.", "label": 0, "category": "none", "hard_negative": true, "source": "holdout-claude"}
{"id": "en-h022", "language": "english", "split": "test", "text": "The lab has ramps and lifts for wheelchair users.", "label": 0, "category": "none", "hard_negative": true, "source": "holdout-claude"}
{"id": "en-h023", "language": "english", "split": "test", "text": "The survey includes a question on how care work is shared in the household.", "label": 0, "category": "none", "hard_negative": false, "source": "holdout-claude"}
{"id": "en-h024", "language": "english", "split": "test", "text": "The research addresses gender bias in hiring algorithms.", "label": 0, "category": "none", "hard_negative": true, "source": "holdout-claude"}
{"id": "en-h025", "language": "english", "split": "test", "text": "The total project budget is 120,000 euros.", "label": 0, "category": "none", "hard_negative": false, "source": "holdout-claude"}
{"id": "en-h026", "language": "english", "split": "test", "text": "Dr. Hernández will lead the working group on active ageing.", "label": 0, "category": "none", "hard_negative": true, "source": "holdout-claude"}
{"id": "en-h027", "language": "english", "split": "test", "text": "In-depth interviews will be conducted with women survivors of gender-based violence.", "label": 0, "category": "none", "hard_negative": true, "source": "holdout-claude"}
{"id": "en-h028", "language": "english", "split": "test", "text": "Older participants reported lower levels of digital literacy.", "label": 0, "category": "none", "hard_negative": true, "source": "holdout-claude"}
{"id": "en-h029", "language": "english", "split": "test", "text": "Mothers in the sample reported more hours of unpaid care than fathers.", "label": 0, "category": "none", "hard_negative": true, "source": "holdout-claude"}
{"id": "en-h030", "language": "english", "split": "test", "text": "Each participant will receive a voucher after completing the interview.", "label": 0, "category": "none", "hard_negative": false, "source": "holdout-claude"}
